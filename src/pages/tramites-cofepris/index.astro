---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { waLink } from "../../lib/whatsapp";
import { faq } from "../../data/tramitesHub";

import TramitesHero from "../../components/tramites/TramitesHero.astro";
import TramitesGrid from "../../components/tramites/TramitesGrid.astro";
import Differentiator from "../../components/tramites/Differentiator.astro";
import RisksSection from "../../components/tramites/RisksSection.astro";
import ProcessSteps from "../../components/tramites/ProcessSteps.astro";
import FaqSection from "../../components/tramites/FaqSection.astro";
import FinalCta from "../../components/tramites/FinalCta.astro";

const tramites = (
  await getCollection("tramites", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
).sort((a, b) => a.data.order - b.data.order);

// Datos derivados para cada card
const cards = await Promise.all(
  tramites.map(async (t) => {
    const services = (
      await Promise.all(t.data.crossSell.map((c) => getEntry(c.service)))
    )
      .filter((s): s is NonNullable<typeof s> => Boolean(s))
      .map((s) => s.data.title);

    const normas = t.data.normativaAplicable
      .map((n) => n.replace(/\s*\[.*?\]/g, "").trim())
      .filter(Boolean)
      .slice(0, 2);

    return { entry: t, services, normas };
  }),
);

const SITE = "https://www.arquimedica.com.mx";
const title = "Trámites COFEPRIS para Clínicas y Hospitales | Arqui-Médica";
const description =
  "Gestionamos licencias sanitarias COFEPRIS para clínicas, hospitales y laboratorios, y dejamos tu infraestructura lista para inspección. Cotiza hoy.";

const generalWa = waLink(
  "Hola, quiero información sobre trámites COFEPRIS para mi establecimiento. Mi establecimiento está en [ciudad/estado].",
);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: "Trámites ante COFEPRIS para establecimientos de salud",
      serviceType: "Gestión de licencias y permisos sanitarios",
      provider: { "@type": "Organization", name: "Arqui-Médica", url: SITE },
      areaServed: { "@type": "Country", name: "México" },
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.answer },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE}/` },
        {
          "@type": "ListItem",
          position: 2,
          name: "Trámites COFEPRIS",
          item: `${SITE}/tramites-cofepris/`,
        },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} jsonLd={schema}>
  <TramitesHero tramites={tramites} generalWa={generalWa} />
  <TramitesGrid cards={cards} />
  <Differentiator />
  <RisksSection generalWa={generalWa} />
  <ProcessSteps />
  <FaqSection />
  <FinalCta generalWa={generalWa} />
</BaseLayout>
