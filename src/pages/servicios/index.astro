---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/container.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import Card from "../../components/ui/Card.astro";
import Hero from "../../components/sections/hero/Hero.astro";
import { buildWhatsAppUrl } from "../../data/navServices";
import {
  Building2,
  Stethoscope,
  FlaskConical,
  Hammer,
  FileCheck,
  CheckCircle,
} from "@lucide/astro";

const iconMap: Record<string, any> = {
  Building2,
  Stethoscope,
  FlaskConical,
  Hammer,
  FileCheck,
  CheckCircle,
};

const services = await getCollection("services");
const sorted = services.sort((a, b) => a.data.order - b.data.order);

const waUrl = buildWhatsAppUrl();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Servicios de Instalaciones Hospitalarias — Arqui-Médica",
  description:
    "Catálogo completo de servicios especializados en infraestructura hospitalaria.",
  itemListElement: sorted.map((s, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: s.data.title,
    url: `https://www.arqui-medica.com/servicios/${s.id}/`,
  })),
};
---

<BaseLayout
  title="Servicios de Instalaciones Hospitalarias | Arqui-Médica"
  description="Catálogo de servicios especializados en infraestructura hospitalaria: gases medicinales, aire acondicionado grado médico, instalaciones eléctricas, tierra física, sistemas de respaldo y más. Cobertura en toda la República Mexicana."
  jsonLd={jsonLd}
>
  <Hero
    title="Infraestructura hospitalaria"
    highlighted="bajo normativa vigente"
    description="Ejecutamos 5 especialidades de instalaciones críticas para hospitales, clínicas y laboratorios en toda la República Mexicana. Cada servicio incluye ingeniería documentada, ejecución con personal propio y carpeta técnica completa para auditorías."
    badgeText="Ingeniería Hospitalaria Especializada"
    showBenefits={false}
  />

  <!-- ── GRID DE SERVICIOS ── -->
  <section class="py-20 bg-white">
    <Container>
      <div class="flex flex-col gap-12">
        <SectionHeader
          eyebrow="Todos los servicios"
          title="¿Qué necesitas para tu proyecto hospitalario?"
          description="Cada servicio tiene página propia con normativa aplicable, proceso detallado y documentación de entrega. Puedes contratar uno o coordinar varios bajo un solo proveedor."
          centered
        />

        <div class="flex flex-wrap gap-1 w-full justify-center">
          {
            sorted.map((service) => (
              <div class="w-84.5 grow-0 shrink-0">
                <Card
                  icon={service.data.icon}
                  title={service.data.title}
                  description={service.data.metaDescription}
                  href={`/servicios/${service.id}/`}
                  image={service.data.gallery?.[0]?.url}
                />
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <!-- ── ¿NO SABES CUÁL NECESITAS? ── -->
  <section class="py-16 bg-neutral-bg border-y border-neutral-border">
    <Container>
      <div class="grid gap-10 lg:grid-cols-2 items-center">
        <div class="flex flex-col gap-5">
          <h2 class="text-2xl font-bold text-brand-dark md:text-3xl">
            ¿No sabes cuál servicio necesitas?
          </h2>
          <p class="text-slate-600 leading-relaxed">
            Es normal. Muchos proyectos hospitalarios requieren varios servicios
            coordinados. Un ingeniero especialista puede revisar tu proyecto y
            decirte exactamente qué instalaciones necesitas, en qué orden
            ejecutarlas y qué normas aplican a tu caso.
          </p>
          <p class="text-slate-600 leading-relaxed">
            La consulta inicial es gratuita y sin compromiso.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-conversion="whatsapp_click_servicios_index"
              class="inline-flex items-center gap-2.5 rounded-xl bg-brand-whatsapp px-7 py-4 font-heading font-bold text-white shadow-sm transition-all hover:scale-[1.02] hover:shadow-md"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                ></path>
              </svg>
              Orientación gratuita por WhatsApp
            </a>
            <a
              href="/contacto/"
              class="inline-flex items-center gap-2 rounded-xl border border-neutral-border bg-white px-6 py-4 font-heading font-semibold text-brand-dark transition-all hover:border-brand-teal-dark hover:shadow-sm"
            >
              Formulario de contacto
            </a>
          </div>
        </div>

        <!-- Checklist de tipos de cliente -->
        <div class="rounded-2xl border border-neutral-border bg-white p-7">
          <p class="font-heading font-bold text-brand-dark text-base mb-5">
            Trabajamos con:
          </p>
          <ul class="flex flex-col gap-4">
            {
              [
                {
                  icon: "Building2",
                  label: "Hospitales públicos y privados",
                  detail: "Proyecto nuevo, ampliación o adecuación",
                },
                {
                  icon: "Stethoscope",
                  label: "Clínicas y consultorios de especialidades",
                  detail: "Equipamiento de áreas clínicas críticas",
                },
                {
                  icon: "FlaskConical",
                  label: "Laboratorios clínicos y de diagnóstico",
                  detail: "Control ambiental y eléctrico de precisión",
                },
                {
                  icon: "Hammer",
                  label: "Constructoras y desarrolladoras",
                  detail: "Subcontrato de instalaciones especializadas",
                },
                {
                  icon: "FileCheck",
                  label: "Unidades con inspección pendiente",
                  detail: "Diagnóstico y corrección urgente",
                },
              ].map(({ icon, label, detail }) => {
                const ItemIcon = iconMap[icon] ?? iconMap.CheckCircle;
                return (
                  <li class="flex items-start gap-3">
                    <div class="w-8 h-8 shrink-0 rounded-lg bg-brand-turquoise/10 flex items-center justify-center text-brand-teal-dark mt-0.5">
                      <ItemIcon class="w-4 h-4" strokeWidth={1.75} />
                    </div>
                    <div class="flex flex-col gap-0.5">
                      <span class="font-semibold text-sm text-brand-dark">
                        {label}
                      </span>
                      <span class="text-xs text-neutral-text">{detail}</span>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
