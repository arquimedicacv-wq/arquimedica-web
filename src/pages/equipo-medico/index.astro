---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/container.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import EquipoCard from "../../components/equipo/EquipoCard.astro";
import EquipoFilters from "../../components/equipo/EquipoFilters.astro";
import { buildWhatsAppUrl } from "../../data/navServices";

const productos = await getCollection("equipo");
const sorted = productos.sort((a, b) => a.data.order - b.data.order);
const subcategorias = [
  ...new Set(sorted.map((p) => p.data.subcategoria)),
].sort();
const waUrl = buildWhatsAppUrl(
  "Hola, me interesa conocer su catalogo de equipo medico.",
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Catalogo de Equipo Medico — Arqui-Medica",
  itemListElement: sorted.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: p.data.nombre,
    url: `https://www.arquimedica.com.mx/equipo-medico/${p.id}/`,
  })),
};
---

<BaseLayout
  title="Catalogo de Equipo Medico | Arqui-Medica"
  description="Catalogo de equipo medico profesional para uso humano y veterinario. Monitores, ventiladores, ecografos, esterilizadores y mas. Cotiza por WhatsApp."
  jsonLd={jsonLd}
>
  <section
    class="relative overflow-hidden bg-gradient-to-br from-slate-50 via-white to-cyan-50 pt-16 pb-12"
  >
    <div
      class="absolute inset-0 pointer-events-none bg-gradient-to-tr from-brand-turquoise/5 via-transparent to-transparent"
    >
    </div>
    <Container>
      <div class="flex flex-col gap-6 max-w-3xl">
        <span
          class="inline-flex w-fit items-center gap-1.5 px-3 py-1.5 rounded-full border border-brand-gold/30 bg-brand-gold/15 text-brand-teal-dark text-xs font-semibold"
        >
          Uso Humano y Veterinario
        </span>
        <h1
          class="text-4xl font-extrabold leading-tight text-slate-900 lg:text-5xl font-heading"
        >
          Catalogo de
          <span class="text-brand-teal-dark"> Equipo Medico</span>
        </h1>
        <p class="max-w-2xl text-lg leading-8 text-slate-600">
          Ofrecemos equipo medico profesional para instalaciones de salud humana
          y veterinaria. Todos nuestros productos cuentan con respaldo tecnico y
          servicio postventa.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-conversion="whatsapp_click_equipo_hero"
            class="inline-flex items-center gap-2.5 rounded-xl bg-brand-whatsapp px-7 py-4 font-heading font-bold text-white shadow-sm transition-all hover:scale-[1.02] hover:shadow-md"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              ></path></svg
            >
            Cotizar por WhatsApp
          </a>
          <a
            href="/contacto/"
            class="inline-flex items-center gap-2 rounded-xl border border-neutral-border bg-white px-6 py-4 font-heading font-semibold text-brand-dark transition-all hover:border-brand-teal-dark hover:shadow-sm"
          >
            Formulario de contacto
          </a>
        </div>
      </div>
    </Container>
  </section>

  <section class="py-16 bg-white">
    <Container>
      <div class="flex flex-col gap-8">
        <SectionHeader
          eyebrow="Catalogo completo"
          title="Equipo medico para cada necesidad"
          description="Filtra por tipo de uso o categoria de producto para encontrar lo que necesitas."
        />

        <EquipoFilters subcategorias={subcategorias} />

        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
          {
            sorted.map((producto) => (
              <div
                data-equipo-card
                data-categoria={producto.data.categoria}
                data-subcategoria={producto.data.subcategoria}
              >
                <EquipoCard
                  id={producto.id}
                  nombre={producto.data.nombre}
                  marca={producto.data.marca}
                  modelo={producto.data.modelo}
                  imagen={producto.data.imagen}
                  descripcionCorta={producto.data.descripcionCorta}
                  subcategoria={producto.data.subcategoria}
                  disponibilidad={producto.data.disponibilidad}
                  destacado={producto.data.destacado}
                  especificaciones={producto.data.especificaciones}
                  whatsappMensaje={producto.data.whatsappMensaje}
                />
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <section class="py-16 bg-neutral-bg border-t border-neutral-border">
    <Container>
      <div
        class="rounded-2xl bg-gradient-to-r from-brand-dark to-brand-teal-dark p-10 text-center flex flex-col items-center gap-6"
      >
        <h2 class="text-2xl md:text-3xl font-bold text-white font-heading">
          No encuentras lo que buscas?
        </h2>
        <p class="text-white/80 max-w-xl text-base">
          Nuestro catalogo se actualiza constantemente. Escribenos por WhatsApp
          y te asesoramos para encontrar el equipo que mejor se adapte a tu
          unidad medica.
        </p>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-conversion="whatsapp_click_equipo_cta"
          class="inline-flex items-center gap-2.5 rounded-xl bg-brand-whatsapp px-8 py-4 font-heading font-bold text-white shadow-sm transition-all hover:scale-[1.02] hover:shadow-md"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="currentColor"
            ><path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path></svg
          >
          Consultar por WhatsApp
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
