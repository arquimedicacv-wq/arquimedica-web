---
import { ChevronDown, Menu, X, MessageCircle } from "@lucide/astro";
import Button from "../ui/Button.astro";
import { navServices, buildWhatsAppUrl } from "../../data/navServices";

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/proyectos-ejecutivos/", label: "Proyectos Ejecutivos" },
  { href: "/nosotros/", label: "Nosotros" },
  { href: "/normativas/", label: "Normativas" },
  { href: "/recursos/", label: "Recursos" },
  { href: "/contacto/", label: "Contacto" },
];
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-neutral-border"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-16">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a
        href="/"
        class="flex items-center shrink-0"
        aria-label="Arqui-Médica, ir a inicio"
      >
        <img
          src="/images/Logo.png"
          alt="Arqui-Médica"
          class="h-14 w-auto"
          width="200"
          height="90"
        />
      </a>

      <!-- Nav desktop -->
      <nav
        class="hidden lg:flex items-center gap-8"
        aria-label="Navegación principal"
      >
        <a
          href="/"
          class="text-sm font-medium text-brand-dark hover:text-brand-turquoise transition-colors"
        >
          Inicio
        </a>

        <!-- Dropdown de servicios -->
        <div class="relative group">
          <button
            class="flex items-center gap-1 text-sm font-medium text-brand-dark hover:text-brand-turquoise transition-colors"
            aria-haspopup="true"
          >
            Servicios
            <ChevronDown
              class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180"
            />
          </button>

          <div
            class="absolute left-1/2 -translate-x-1/2 top-full pt-3 w-80 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200"
          >
            <div
              class="bg-white rounded-xl border border-neutral-border shadow-lg p-3 grid grid-cols-1 gap-1"
            >
              {
                navServices.map((service) => (
                  <a
                    href={`/servicios/${service.slug}/`}
                    class="px-3 py-2 rounded-lg text-sm text-brand-dark hover:bg-neutral-bg hover:text-brand-turquoise transition-colors"
                  >
                    {service.name}
                  </a>
                ))
              }
              <a
                href="/servicios/"
                class="px-3 py-2 rounded-lg text-sm font-semibold text-brand-turquoise hover:bg-neutral-bg transition-colors border-t border-neutral-border mt-1 pt-3"
              >
                Ver todos los servicios
              </a>
            </div>
          </div>
        </div>

        <a
          href="/proyectos-ejecutivos/"
          class="text-sm font-medium text-brand-dark hover:text-brand-turquoise transition-colors"
        >
          Proyectos Ejecutivos
        </a>

        <a
          href="/nosotros/"
          class="text-sm font-medium text-brand-dark hover:text-brand-turquoise transition-colors"
        >
          Nosotros
        </a>
        <a
          href="/normativas/"
          class="text-sm font-medium text-brand-dark hover:text-brand-turquoise transition-colors"
        >
          Normativas
        </a>
        <a
          href="/recursos/"
          class="text-sm font-medium text-brand-dark hover:text-brand-turquoise transition-colors"
        >
          Recursos
        </a>
        <a
          href="/contacto/"
          class="text-sm font-medium text-brand-dark hover:text-brand-turquoise transition-colors"
        >
          Contacto
        </a>
      </nav>

      <!-- CTA desktop -->
      <div class="hidden lg:block">
        <Button
          variant="whatsapp"
          size="sm"
          href={buildWhatsAppUrl()}
          conversionLabel="whatsapp_click_header"
        >
          Cotizar por WhatsApp
        </Button>
      </div>

      <!-- Botón menú mobile -->
      <button
        id="mobile-menu-toggle"
        class="lg:hidden p-2 text-brand-dark"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu class="w-6 h-6" id="icon-menu" />
        <X class="w-6 h-6 hidden" id="icon-close" />
      </button>
    </div>
  </div>

  <!-- Menú mobile -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-neutral-border bg-white"
  >
    <nav class="flex flex-col px-6 py-4 gap-1" aria-label="Navegación mobile">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="py-3 text-base font-medium text-brand-dark border-b border-neutral-border last:border-0"
          >
            {link.label}
          </a>
        ))
      }

      <p
        class="pt-4 pb-2 text-xs font-semibold text-neutral-text uppercase tracking-wide"
      >
        Servicios
      </p>
      {
        navServices.map((service) => (
          <a
            href={`/servicios/${service.slug}/`}
            class="py-2.5 text-sm text-brand-dark"
          >
            {service.name}
          </a>
        ))
      }

      <a
        href={buildWhatsAppUrl()}
        data-conversion="whatsapp_click_mobile_menu"
        class="mt-4 flex items-center justify-center gap-2 bg-brand-whatsapp text-white font-heading font-semibold rounded-lg px-6 py-3"
      >
        <MessageCircle class="w-5 h-5" />
        Cotizar por WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    iconMenu?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });
</script>
