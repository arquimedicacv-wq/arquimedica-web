---
// WhatsAppFloat.astro
// Persistente en todo el sitio — "red de seguridad" de conversión (Etapa 6).
// El mensaje precargado cambia según la página de origen para reducir
// fricción y mejorar la calidad del lead (ej. en la página de un servicio
// específico, ya menciona ese servicio).

import { MessageCircle } from "@lucide/astro";
import { buildWhatsAppUrl } from "../../data/navServices";

interface Props {
  message?: string;
  conversionLabel?: string;
}

const { message, conversionLabel = "whatsapp_click_float" } = Astro.props;
---

<a
  href={buildWhatsAppUrl(message)}
  target="_blank"
  rel="noopener noreferrer"
  data-conversion={conversionLabel}
  aria-label="Cotizar por WhatsApp"
  class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-brand-whatsapp text-white shadow-lg flex items-center justify-center hover:scale-105 transition-transform duration-200"
>
  <MessageCircle class="w-7 h-7" stroke-Width={2} />
  <span class="sr-only">Cotizar por WhatsApp</span>
</a>
