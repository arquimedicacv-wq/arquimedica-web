---
interface Props {
  generalWa: string;
}
const { generalWa } = Astro.props;
---

<section class="bg-brand-dark text-white">
  <div class="max-w-4xl mx-auto px-4 py-16 text-center">
    <h2 class="text-2xl md:text-3xl font-bold">
      Cuéntanos tu proyecto y recibe un diagnóstico en menos de 24 horas
    </h2>
    <p class="mt-3 text-white/80">
      Sin costo y sin compromiso. Un especialista revisa tu caso.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href={generalWa}
        target="_blank"
        rel="noopener"
        class="rounded-lg bg-brand-turquoise px-6 py-3 font-semibold text-brand-dark hover:opacity-90"
      >
        Escribir por WhatsApp
      </a>
      <a
        href="/contacto/?tramite=general"
        class="rounded-lg border border-white/30 px-6 py-3 font-semibold hover:bg-white/10"
      >
        Llenar formulario
      </a>
    </div>
  </div>
</section>
