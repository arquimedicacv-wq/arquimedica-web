---
import { risks } from "../../data/tramitesHub";

interface Props {
  generalWa: string;
}
const { generalWa } = Astro.props;

// Un ícono por riesgo, en el mismo orden que tramitesHub.ts
const icons = [
  // Suspensión y sanciones
  "M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z",
  // Apertura retrasada
  "M12 6v6l4 2m6-2a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z",
  // Retrabajo en obra
  "M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4 2.6-2.6Z",
  // Riesgo para tus pacientes
  "M12 21s-7-4.5-9-9.5C1.7 8 3.5 5 6.5 5c2 0 3.5 1 5.5 3 2-2 3.5-3 5.5-3 3 0 4.8 3 3.5 6.5-2 5-9 9.5-9 9.5Z",
];
---

<section class="relative overflow-hidden bg-white">
  <div
    class="pointer-events-none absolute -left-32 top-1/2 h-96 w-96 -translate-y-1/2 rounded-full bg-amber-100/60 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative max-w-6xl mx-auto px-4 py-16 md:py-24 grid lg:grid-cols-12 gap-12 items-start"
  >
    <!-- Columna izquierda -->
    <div class="lg:col-span-5 lg:sticky lg:top-24">
      <p
        class="inline-flex items-center gap-2 rounded-full bg-amber-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-amber-700"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
        Lo que está en juego
      </p>
      <h2
        class="mt-4 text-3xl md:text-4xl font-extrabold leading-tight tracking-tight text-brand-dark"
      >
        El costo de operar sin licencia
      </h2>
      <p class="mt-4 text-slate-600 leading-relaxed">
        Regularizarte a tiempo casi siempre sale más barato que corregir
        después. Cada mes sin autorización es un mes de riesgo para tu
        establecimiento y para tus pacientes.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row lg:flex-col xl:flex-row gap-3">
        <a
          href={generalWa}
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center justify-center gap-2 rounded-xl bg-brand-turquoise px-6 py-3.5 font-bold text-white shadow-lg shadow-brand-turquoise/25 transition hover:-translate-y-0.5 hover:shadow-xl focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-turquoise/40"
        >
          Iniciar mi trámite hoy
          <span class="transition group-hover:translate-x-1" aria-hidden="true"
            >→</span
          >
        </a>
        <a
          href="/contacto/?tramite=general"
          class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-6 py-3.5 font-semibold text-brand-dark transition hover:border-brand-turquoise focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-turquoise/30"
        >
          Recibir diagnóstico gratis
        </a>
      </div>
    </div>

    <!-- Tarjetas -->
    <div class="lg:col-span-7 grid sm:grid-cols-2 gap-5">
      {
        risks.map((r, i) => (
          <div class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-amber-300 hover:shadow-xl">
            <span
              class="absolute right-4 top-3 text-5xl font-extrabold leading-none text-slate-100 transition group-hover:text-amber-100"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, "0")}
            </span>

            <span class="relative flex h-12 w-12 items-center justify-center rounded-xl bg-amber-100 text-amber-600 transition group-hover:bg-amber-500 group-hover:text-white">
              <svg
                viewBox="0 0 24 24"
                class="h-6 w-6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={icons[i % icons.length]} />
              </svg>
            </span>

            <h3 class="relative mt-5 text-lg font-bold text-brand-dark">
              {r.title}
            </h3>
            <p class="relative mt-2 text-sm leading-relaxed text-slate-600">
              {r.text}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
