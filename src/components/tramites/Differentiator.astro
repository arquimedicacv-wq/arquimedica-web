---
const services = [
  { label: "Gases medicinales", href: "/servicios/gases-medicinales/" },
  {
    label: "Instalación eléctrica hospitalaria",
    href: "/servicios/instalacion-electrica-hospitalaria/",
  },
  {
    label: "Aire acondicionado grado médico",
    href: "/servicios/aire-acondicionado-grado-medico/",
  },
  { label: "Pisos conductivos", href: "/servicios/piso-vinilico-conductivo/" },
];

const rows = [
  {
    topic: "Interlocutor",
    other: "Un gestor y un contratista por separado",
    us: "Un solo interlocutor técnico, del diagnóstico a la licencia",
  },
  {
    topic: "Fallas en instalaciones",
    other: "Te dejan buscando quién las corrija",
    us: "Las corregimos nosotros y seguimos con tu trámite",
  },
  {
    topic: "Revisión",
    other: "Las observaciones aparecen en la inspección",
    us: "Revisión previa para detectar fallas antes de ingresar",
  },
  {
    topic: "Documentación",
    other: "Solo el expediente del trámite",
    us: "Memorias, pruebas y planos as-built listos para inspección",
  },
];
---

<section
  class="relative isolate overflow-hidden bg-brand-dark text-white"
  style={`background-size:auto,44px 44px,44px 44px;`}
>
  <div
    class="max-w-6xl mx-auto px-4 py-16 md:py-24 grid lg:grid-cols-12 gap-12 items-center"
  >
    <!-- Texto -->
    <div class="lg:col-span-5">
      <p
        class="text-sm font-semibold uppercase tracking-wider text-brand-turquoise"
      >
        Nuestra diferencia
      </p>
      <h2
        class="mt-3 text-3xl md:text-4xl font-extrabold leading-tight tracking-tight"
      >
        No solo tramitamos:
        <span class="text-brand-turquoise"
          >construimos lo que la autoridad revisa</span
        >
      </h2>
      <p class="mt-5 text-white/75 leading-relaxed">
        Muchas gestorías ingresan tu expediente y, si la inspección detecta
        fallas en instalaciones, te dejan buscando contratista. En Arqui-Médica
        diseñamos y ejecutamos <strong class="text-white"
          >gases medicinales</strong
        >,
        <strong class="text-white"> instalación eléctrica hospitalaria</strong>,
        <strong class="text-white"> aire acondicionado grado médico</strong> y pisos
        conductivos, así que corregimos la brecha y seguimos con tu trámite.
      </p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {
          services.map((s) => (
            <li>
              <a
                href={s.href}
                class="inline-block rounded-full border border-white/20 bg-white/5 px-3.5 py-1.5 text-xs font-medium transition hover:border-brand-turquoise hover:bg-brand-turquoise/10 hover:text-brand-turquoise"
              >
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href="/servicios/"
        class="group mt-8 inline-flex items-center gap-2 font-semibold text-brand-turquoise"
      >
        Ver nuestros servicios de ingeniería
        <span class="transition group-hover:translate-x-1" aria-hidden="true"
          >→</span
        >
      </a>
    </div>

    <!-- Comparativa -->
    <div class="lg:col-span-7">
      <div
        class="overflow-hidden rounded-3xl border border-white/15 bg-white/6 shadow-2xl shadow-black/30 backdrop-blur-xl"
      >
        <!-- Encabezados -->
        <div
          class="grid grid-cols-2 text-xs font-bold uppercase tracking-wider"
        >
          <div class="px-5 py-4 text-white/50">Gestoría tradicional</div>
          <div class="bg-brand-turquoise px-5 py-4 text-brand-dark">
            Arqui-Médica
          </div>
        </div>

        {
          rows.map((r) => (
            <div class="grid grid-cols-2 border-t border-white/10">
              <div class="flex gap-3 px-5 py-5 text-sm text-white/55">
                <span class="mt-0.5 text-red-300/80" aria-hidden="true">
                  ✕
                </span>
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-wider text-white/35">
                    {r.topic}
                  </p>
                  <p class="mt-1">{r.other}</p>
                </div>
              </div>
              <div class="flex gap-3 bg-brand-turquoise/10 px-5 py-5 text-sm text-white">
                <span
                  class="mt-0.5 font-bold text-brand-turquoise"
                  aria-hidden="true"
                >
                  ✓
                </span>
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-wider text-brand-turquoise/80">
                    {r.topic}
                  </p>
                  <p class="mt-1 font-medium">{r.us}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
