---
import type { CollectionEntry } from "astro:content";
import { waLink } from "../../lib/whatsapp";

interface Props {
  entry: CollectionEntry<"tramites">;
  services: string[];
  normas: string[];
  index: number;
}
const { entry: t, services, normas, index } = Astro.props;
---

<article
  class="group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-brand-turquoise/60 hover:shadow-xl"
>
  <div
    class="h-1 w-full origin-left scale-x-0 bg-linear-to-r from-brand-turquoise to-emerald-300 transition-transform duration-300 group-hover:scale-x-100"
    aria-hidden="true"
  >
  </div>

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-start justify-between gap-3">
      <span
        class="rounded-full bg-brand-turquoise/15 px-3 py-1 text-xs font-semibold text-brand-dark"
      >
        {t.data.badge}
      </span>
      <span
        class="text-4xl font-extrabold leading-none text-slate-100 transition group-hover:text-brand-turquoise/30"
        aria-hidden="true"
      >
        {String(index + 1).padStart(2, "0")}
      </span>
    </div>

    <h3 class="mt-4 text-xl font-bold leading-snug text-brand-dark">
      <a
        href={`/tramites-cofepris/${t.id}/`}
        class="after:absolute after:inset-0 hover:text-brand-turquoise"
      >
        {t.data.shortTitle}
      </a>
    </h3>

    <p class="mt-2 text-sm text-slate-600 line-clamp-3">{t.data.whoNeeds}</p>

    {
      normas.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {normas.map((n) => (
            <span class="rounded-md border border-slate-200 bg-slate-50 px-2 py-1 text-[11px] font-medium text-slate-600">
              {n}
            </span>
          ))}
        </div>
      )
    }

    <div class="mt-5">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
        Qué incluye
      </p>
      <ul class="mt-2 space-y-1.5">
        {
          t.data.deliverables.slice(0, 3).map((d) => (
            <li class="flex gap-2 text-sm text-slate-700">
              <span class="mt-0.5 text-brand-turquoise font-bold">✓</span>
              <span class="line-clamp-2">{d}</span>
            </li>
          ))
        }
      </ul>
      {
        t.data.deliverables.length > 3 && (
          <p class="mt-2 text-xs text-slate-400">
            +{t.data.deliverables.length - 3} entregables más
          </p>
        )
      }
    </div>

    {
      services.length > 0 && (
        <div class="mt-5 rounded-lg bg-brand-dark/4 p-3">
          <p class="text-xs font-semibold text-brand-dark">
            + Ingeniería para dejarte listo:
          </p>
          <p class="mt-1 text-xs text-slate-600">{services.join(" · ")}</p>
        </div>
      )
    }
  </div>

  <div
    class="relative z-10 flex flex-col gap-2 border-t border-slate-100 bg-slate-50/60 p-4"
  >
    <a
      href={waLink(t.data.whatsappMessage)}
      target="_blank"
      rel="noopener"
      class="rounded-lg bg-brand-dark px-4 py-3 text-center text-sm font-semibold text-white transition hover:bg-brand-turquoise hover:text-brand-dark focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-turquoise/40"
    >
      Cotizar este trámite
    </a>
    <a
      href={`/tramites-cofepris/${t.id}/`}
      class="text-center text-sm font-medium text-brand-dark hover:text-brand-turquoise"
    >
      Ver requisitos y proceso →
    </a>
  </div>
</article>
