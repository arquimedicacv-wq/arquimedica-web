---
import type { CollectionEntry } from "astro:content";
import TramiteCard from "./TramiteCard.astro";

interface Props {
  cards: {
    entry: CollectionEntry<"tramites">;
    services: string[];
    normas: string[];
  }[];
}
const { cards } = Astro.props;
---

<section class="max-w-7xl mx-auto px-4 py-16 md:py-20">
  <div class="max-w-2xl">
    <p
      class="text-sm font-semibold uppercase tracking-wider text-brand-turquoise"
    >
      Catálogo
    </p>
    <h2 class="mt-2 text-3xl md:text-4xl font-bold text-brand-dark">
      Licencias y permisos sanitarios que gestionamos
    </h2>
    <p class="mt-3 text-slate-600">
      ¿No sabes cuál necesitas? Escríbenos y lo definimos contigo en la primera
      conversación.
    </p>
  </div>

  <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-2">
    {cards.map((c, i) => <TramiteCard {...c} index={i} />)}
  </div>
</section>
