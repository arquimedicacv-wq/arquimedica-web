---
import { faq } from "../../data/tramitesHub";
---

<section class="max-w-3xl mx-auto px-4 py-16">
  <h2 class="text-2xl md:text-3xl font-bold text-brand-dark">
    Preguntas frecuentes sobre trámites COFEPRIS
  </h2>
  <div class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
    {
      faq.map((f) => (
        <details class="group py-4">
          <summary class="cursor-pointer font-semibold text-brand-dark">
            {f.question}
          </summary>
          <p class="mt-2 text-slate-600">{f.answer}</p>
        </details>
      ))
    }
  </div>
</section>
