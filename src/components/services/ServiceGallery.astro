---
import { Image } from "astro:assets";
import { getGalleryImage } from "../../images/servicios/index";

interface GalleryImage {
  url: string;
  alt: string;
}
interface Props {
  gallery: GalleryImage[];
}

const { gallery } = Astro.props;
---

<section class="py-16 bg-white border-b border-neutral-border">
  <div class="max-w-7xl mx-auto px-6 lg:px-16">
    <div class="flex flex-col gap-10">
      <div class="flex flex-col gap-2">
        <span class="text-sm font-semibold uppercase tracking-[0.2em] text-teal-600">Evidencia Técnica</span>
        <h2 class="text-2xl font-bold text-brand-dark md:text-3xl">Galería de instalaciones</h2>
        <p class="text-sm text-slate-500 max-w-2xl leading-relaxed">
          Ejemplos de instalaciones y equipamiento ejecutado bajo nuestros estándares técnicos.
        </p>
      </div>
      <div class="grid gap-2 md:grid-cols-3">
        {gallery.map((img) => {
          const localImage = getGalleryImage(img.url);
          return (
            <div class="group relative overflow-hidden rounded-2xl border border-neutral-border bg-neutral-bg shadow-sm">
              <div class="aspect-video w-full overflow-hidden">
                {localImage ? (
                  <Image src={localImage} alt={img.alt} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                ) : (
                  <Image src={img.url} alt={img.alt} width={800} height={450} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                )}
              </div>
              <div class="p-4 border-t border-neutral-border bg-white">
                <p class="text-sm font-medium text-slate-700">{img.alt}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
