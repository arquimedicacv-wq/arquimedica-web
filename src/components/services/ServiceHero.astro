---
import { Image } from "astro:assets";
import { getGalleryImage } from "../../images/servicios/index";
import Container from "../ui/container.astro";
import Badge from "../ui/Badge.astro";

interface Props {
  title: string;
  heroTitle: string;
  heroSubtitle: string;
  slug: string;
  waUrl: string;
  ServiceIcon: any;
  gallery: { url: string; alt: string }[];
}

const { title, heroTitle, heroSubtitle, slug, waUrl, ServiceIcon, gallery } = Astro.props;
const collageImages = gallery.slice(0, 6);
const extraCount = Math.max(gallery.length - collageImages.length, 0);

type Tile = { top: string; left: string; w: string; h: string; z: number };

const collageLayouts: Record<number, Tile[]> = {
  1: [{ top: "48%", left: "12%", w: "80%", h: "84%", z: 10 }],
  2: [
    { top: "2%", left: "0%", w: "62%", h: "56%", z: 10 },
    { top: "38%", left: "42%", w: "58%", h: "58%", z: 20 },
  ],
  3: [
    { top: "0%", left: "4%", w: "56%", h: "46%", z: 10 },
    { top: "8%", left: "52%", w: "48%", h: "40%", z: 15 },
    { top: "46%", left: "22%", w: "60%", h: "50%", z: 25 },
  ],
  4: [
    { top: "0%", left: "0%", w: "50%", h: "42%", z: 10 },
    { top: "4%", left: "46%", w: "52%", h: "38%", z: 15 },
    { top: "40%", left: "4%", w: "44%", h: "46%", z: 20 },
    { top: "44%", left: "46%", w: "52%", h: "50%", z: 25 },
  ],
  5: [
    { top: "0%", left: "2%", w: "46%", h: "36%", z: 10 },
    { top: "2%", left: "48%", w: "50%", h: "34%", z: 12 },
    { top: "28%", left: "0%", w: "40%", h: "38%", z: 18 },
    { top: "30%", left: "38%", w: "44%", h: "42%", z: 28 },
    { top: "64%", left: "12%", w: "56%", h: "34%", z: 22 },
  ],
  6: [
    { top: "0%", left: "0%", w: "42%", h: "32%", z: 10 },
    { top: "2%", left: "42%", w: "44%", h: "30%", z: 12 },
    { top: "30%", left: "0%", w: "36%", h: "34%", z: 16 },
    { top: "28%", left: "37%", w: "40%", h: "38%", z: 28 },
    { top: "60%", left: "6%", w: "48%", h: "34%", z: 20 },
    { top: "58%", left: "50%", w: "42%", h: "36%", z: 24 },
  ],
};
const collageLayout = collageLayouts[collageImages.length] ?? null;
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-dark via-brand-teal-dark to-brand-dark h-[93vh] flex items-center">
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: url('data:image/svg+xml,%3Csvg%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%221%22%3E%3Cpath%20d%3D%22M36%2034v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6%2034v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6%204V0H4v4H0v2h4v4h2V6h4V4H6z%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E');"></div>

  <Container>
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="flex flex-col gap-7">
        <nav class="flex items-center gap-2 text-sm text-white/50" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white/80 transition-colors">Inicio</a>
          <span>/</span>
          <a href="/servicios/" class="hover:text-white/80 transition-colors">Servicios</a>
          <span>/</span>
          <span class="text-white/80">{title}</span>
        </nav>

        <Badge text="Instalaciones Hospitalarias Certificadas" variant="white" />

        <h1 class="text-3xl font-extrabold leading-tight text-white md:text-4xl xl:text-5xl">
          {heroTitle}
        </h1>
        <p class="max-w-xl text-lg leading-8 text-white/70">
          {heroSubtitle}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 z-10">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-conversion={`whatsapp_click_service_${slug}`}
            class="inline-flex items-center gap-2.5 rounded-xl bg-brand-whatsapp px-7 py-4 font-heading font-bold text-white shadow-lg shadow-black/20 transition-all hover:scale-[1.02] hover:shadow-xl"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Cotizar este servicio
          </a>
          <a
            href="#proceso"
            class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-6 py-4 font-heading font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/20"
          >
            Ver cómo trabajamos
          </a>
        </div>
      </div>

      <div class="hidden lg:flex items-center justify-center">
        <div class="relative h-[420px] w-[380px] xl:h-[560px] xl:w-[520px]">
          <div class="absolute -right-10 top-1/2 h-64 w-64 -translate-y-1/2 rounded-full bg-brand-turquoise/25 blur-2xl"></div>

          {collageLayout ? (
            <div class="relative h-full w-full">
              {collageImages.map((img, i) => {
                const localImage = getGalleryImage(img.url);
                return (
                  <div
                    class="absolute overflow-hidden rounded-2xl ring-4 ring-white/90 shadow-xl shadow-black/30"
                    style={`top:${collageLayout[i].top}; left:${collageLayout[i].left}; width:${collageLayout[i].w}; height:${collageLayout[i].h}; z-index:${collageLayout[i].z};`}
                  >
                    {localImage ? (
                      <Image src={localImage} alt={img.alt} class="h-full w-full object-cover" loading="lazy" />
                    ) : (
                      <Image src={img.url} alt={img.alt} width={400} height={300} class="h-full w-full object-cover" loading="lazy" />
                    )}
                    {i === collageImages.length - 1 && extraCount > 0 && (
                      <div class="absolute inset-0 flex items-center justify-center bg-brand-dark/60 backdrop-blur-[1px]">
                        <span class="font-heading font-bold text-white text-lg">+{extraCount}</span>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          ) : (
            <div class="relative flex h-64 w-64 mx-auto items-center justify-center rounded-3xl bg-white/10 backdrop-blur-sm border border-white/10">
              <ServiceIcon class="w-32 h-32 text-white/80" strokeWidth={0.75} />
            </div>
          )}

          {collageLayout && (
            <div class="absolute bottom-2 left-2 z-30 flex h-20 w-20 items-center justify-center rounded-full bg-white shadow-lg shadow-black/25 ring-4 ring-brand-dark/10">
              <ServiceIcon class="w-10 h-10 text-brand-teal-dark" strokeWidth={1.5} />
            </div>
          )}
        </div>
      </div>
    </div>
  </Container>
</section>
