---
import { AlertTriangle } from "@lucide/astro";

interface Props {
  painPoints: string[];
}

const { painPoints } = Astro.props;
---

<section class="py-16 bg-white border-b border-neutral-border">
  <div class="max-w-7xl mx-auto px-6 lg:px-16">
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-2">
        <span
          class="text-sm font-semibold uppercase tracking-[0.2em] text-red-500"
          >¿Por qué importa?</span
        >
        <h2 class="text-2xl font-bold text-brand-dark md:text-3xl">
          El costo de no atenderlo
        </h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          painPoints.map((point) => (
            <div class="flex gap-3 rounded-xl border border-red-100 bg-red-50 p-5">
              <div class="mt-0.5 shrink-0">
                <AlertTriangle class="w-4 h-4 text-red-500" stroke-width={2} />
              </div>
              <p class="text-sm leading-relaxed text-slate-700">{point}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
