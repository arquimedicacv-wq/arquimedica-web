---
import {
  ShieldCheck,
  PanelTop,
  Wind,
  LayoutGrid,
  Zap,
  Plug,
  Snowflake,
  BatteryCharging,
  Settings,
} from "@lucide/astro";

const iconMap: Record<string, any> = {
  ShieldCheck,
  PanelTop,
  Wind,
  LayoutGrid,
  Zap,
  Plug,
  Snowflake,
  BatteryCharging,
  Settings,
};

interface RelatedItem {
  id: string;
  data: {
    title: string;
    metaDescription: string;
    icon: string;
  };
}
interface Props {
  related: RelatedItem[];
}

const { related } = Astro.props;
---

<section class="py-16 bg-neutral-bg">
  <div class="max-w-7xl mx-auto px-6 lg:px-16">
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-2">
        <span
          class="text-sm font-semibold uppercase tracking-[0.2em] text-teal-600"
          >También podría interesarte</span
        >
        <h2 class="text-2xl font-bold text-brand-dark">
          Servicios relacionados
        </h2>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          related.map((rel) => {
            const RelIcon = iconMap[rel.data.icon] ?? iconMap.Settings;
            return (
              <a
                href={`/servicios/${rel.id}/`}
                class="group flex flex-col gap-4 rounded-xl border border-neutral-border bg-white p-6 transition-all hover:border-brand-turquoise/50 hover:shadow-md"
              >
                <div class="w-10 h-10 rounded-lg bg-brand-turquoise/10 flex items-center justify-center text-brand-teal-dark group-hover:bg-brand-turquoise group-hover:text-white transition-colors">
                  <RelIcon class="w-5 h-5" strokeWidth={1.75} />
                </div>
                <div class="flex flex-col gap-1.5">
                  <h3 class="font-heading font-bold text-brand-dark text-base">
                    {rel.data.title}
                  </h3>
                  <p class="text-xs text-neutral-text leading-relaxed line-clamp-2">
                    {rel.data.metaDescription}
                  </p>
                </div>
                <span class="mt-auto text-xs font-semibold text-brand-turquoise flex items-center gap-1">
                  Ver servicio
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
