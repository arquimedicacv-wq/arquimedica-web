---
import Section from "../ui/Section.astro";
import Container from "../ui/container.astro";
import { navServices } from "../../data/navServices";
import { buildWhatsAppUrl } from "../../data/navServices";

const whatsappUrl = buildWhatsAppUrl(
  "Hola, me interesa cotizar un proyecto de instalaciones hospitalarias.",
);
---

<Section id="cotizar" class="bg-neutral-bg">
  <Container>
    <div class="grid gap-12 lg:grid-cols-2 items-center">
      <!-- Left: copy de venta -->
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-4">
          <span
            class="text-sm font-semibold uppercase tracking-[0.2em] text-teal-600"
          >
            Solicitar cotización
          </span>
          <h2
            class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl"
          >
            Cuéntanos tu proyecto. <br class="hidden md:block" />
            <span class="text-brand-turquoise"
              >Te respondemos en menos de 24 horas.</span
            >
          </h2>
          <p class="max-w-md text-lg leading-8 text-slate-600">
            Sin compromisos. Sin vendedores genéricos. Un ingeniero especialista
            revisa tu solicitud y te da una orientación técnica inicial
            gratuita.
          </p>
        </div>

        <!-- Trust bullets -->
        <ul class="flex flex-col gap-3">
          {
            [
              "Sin costo por la cotización inicial",
              "Respuesta de un ingeniero, no de un vendedor",
              "Propuesta detallada y itemizada",
              "Confidencialidad garantizada",
            ].map((item) => (
              <li class="flex items-center gap-3 text-sm text-slate-600">
                <span class="flex h-5 w-5 items-center justify-center rounded-full bg-brand-turquoise/15 text-brand-teal-dark shrink-0">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-3 w-3"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </span>
                {item}
              </li>
            ))
          }
        </ul>

        <!-- WhatsApp CTA (alternative) -->
        <div class="flex flex-col gap-2">
          <p
            class="text-xs text-neutral-text uppercase tracking-wide font-semibold"
          >
            ¿Prefieres contacto inmediato?
          </p>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-conversion="whatsapp_click_cta"
            class="inline-flex w-fit items-center gap-3 rounded-xl bg-brand-whatsapp px-7 py-4 font-heading font-bold text-white text-base shadow-lg shadow-brand-whatsapp/25 transition-all hover:scale-[1.02] hover:shadow-xl hover:shadow-brand-whatsapp/30"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-6 h-6"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              ></path>
            </svg>
            Escribir por WhatsApp ahora
          </a>
        </div>
      </div>

      <!-- Right: form card -->
      <div
        class="rounded-2xl border border-neutral-border bg-white p-8 shadow-sm"
      >
        <form
          id="cta-form"
          action="https://formspree.io/f/mdaqller"
          method="POST"
          class="flex flex-col gap-5"
        >
          <input type="hidden" name="_subject" value="Nueva solicitud de cotización — Arqui-Médica" />

          <div class="flex flex-col gap-1.5">
            <label for="nombre" class="text-sm font-semibold text-brand-dark"
              >Nombre completo *</label
            >
            <input
              id="nombre"
              name="nombre"
              type="text"
              required
              placeholder="Ej. Arq. Juan Pérez"
              class="w-full rounded-lg border border-neutral-border px-4 py-3 text-sm text-brand-dark placeholder-neutral-text/60 transition-all outline-none focus:border-brand-turquoise focus:ring-2 focus:ring-brand-turquoise/15"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="email" class="text-sm font-semibold text-brand-dark"
              >Correo electrónico *</label
            >
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="correo@empresa.com"
              class="w-full rounded-lg border border-neutral-border px-4 py-3 text-sm text-brand-dark placeholder-neutral-text/60 transition-all outline-none focus:border-brand-turquoise focus:ring-2 focus:ring-brand-turquoise/15"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="telefono" class="text-sm font-semibold text-brand-dark"
              >Teléfono / WhatsApp</label
            >
            <input
              id="telefono"
              name="telefono"
              type="tel"
              placeholder="+52 55 1907 4304"
              class="w-full rounded-lg border border-neutral-border px-4 py-3 text-sm text-brand-dark placeholder-neutral-text/60 transition-all outline-none focus:border-brand-turquoise focus:ring-2 focus:ring-brand-turquoise/15"
            />
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
              <label
                for="tipo-institucion"
                class="text-sm font-semibold text-brand-dark"
                >Tipo de institución *</label
              >
              <select
                id="tipo-institucion"
                name="tipo_institucion"
                required
                class="w-full rounded-lg border border-neutral-border px-4 py-3 text-sm text-brand-dark transition-all outline-none focus:border-brand-turquoise focus:ring-2 focus:ring-brand-turquoise/15 bg-white"
              >
                <option value="" disabled selected>Seleccionar...</option>
                <option value="hospital-publico">Hospital público</option>
                <option value="hospital-privado">Hospital privado</option>
                <option value="clinica">Clínica</option>
                <option value="laboratorio">Laboratorio</option>
                <option value="centro-medico">Centro médico</option>
                <option value="constructora"
                  >Constructora / Desarrolladora</option
                >
                <option value="otro">Otro</option>
              </select>
            </div>

            <div class="flex flex-col gap-1.5">
              <label
                for="servicio"
                class="text-sm font-semibold text-brand-dark"
                >Servicio de interés *</label
              >
              <select
                id="servicio"
                name="servicio"
                required
                class="w-full rounded-lg border border-neutral-border px-4 py-3 text-sm text-brand-dark transition-all outline-none focus:border-brand-turquoise focus:ring-2 focus:ring-brand-turquoise/15 bg-white"
              >
                <option value="" disabled selected>Seleccionar...</option>
                {
                  navServices.map((s) => (
                    <option value={s.slug}>{s.name}</option>
                  ))
                }
                <option value="varios">Varios servicios</option>
                <option value="no-se">No estoy seguro</option>
              </select>
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="mensaje" class="text-sm font-semibold text-brand-dark"
              >Cuéntanos más sobre el proyecto</label
            >
            <textarea
              id="mensaje"
              name="mensaje"
              rows="3"
              placeholder="Tipo de obra, estado de avance, plazos estimados..."
              class="w-full rounded-lg border border-neutral-border px-4 py-3 text-sm text-brand-dark placeholder-neutral-text/60 transition-all outline-none focus:border-brand-turquoise focus:ring-2 focus:ring-brand-turquoise/15 resize-none"
            ></textarea>
          </div>

          <div id="cta-success" class="hidden rounded-lg bg-green-50 border border-green-200 p-4 text-sm text-green-800">
            Correo enviado exitosamente, nos pondremos en contacto lo antes posible.
          </div>

          <button
            id="cta-submit-btn"
            type="submit"
            data-conversion="form_submit_cta"
            class="w-full rounded-lg bg-brand-turquoise px-6 py-4 font-heading font-bold text-white transition-all hover:scale-[1.01] hover:shadow-lg hover:shadow-brand-turquoise/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-turquoise"
          >
            Solicitar cotización gratuita
          </button>

          <p class="text-center text-xs text-neutral-text">
            Al enviar aceptas nuestro{" "}
            <a
              href="/aviso-de-privacidad/"
              class="underline hover:text-brand-teal-dark"
              >aviso de privacidad</a
            >.
          </p>
        </form>

<script>
  const ctaForm = document.getElementById("cta-form");
  const ctaSuccess = document.getElementById("cta-success");
  const ctaSubmitBtn = document.getElementById("cta-submit-btn");

  ctaForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    ctaSubmitBtn.disabled = true;
    ctaSubmitBtn.textContent = "Enviando...";

    try {
      const res = await fetch(ctaForm.action, {
        method: "POST",
        body: new FormData(ctaForm),
        headers: { Accept: "application/json" },
      });

      if (res.ok) {
        ctaForm.reset();
        ctaSuccess.classList.remove("hidden");
        ctaSuccess.scrollIntoView({ behavior: "smooth", block: "center" });
      } else {
        alert("Ocurrió un error al enviar el mensaje. Intenta de nuevo.");
      }
    } catch {
      alert("Error de conexión. Verifica tu internet e intenta de nuevo.");
    } finally {
      ctaSubmitBtn.disabled = false;
      ctaSubmitBtn.textContent = "Solicitar cotización gratuita";
    }
  });
</script>
      </div>
    </div>
  </Container>
</Section>
