---
import Section from "../ui/Section.astro";
import Container from "../ui/container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import {
  BookOpen,
  ClipboardCheck,
  Timer,
  Headphones,
  FileText,
  MapPin,
} from "@lucide/astro";

const differentiators = [
  {
    Icon: BookOpen,
    title: "Dominio normativo profundo",
    description:
      "Conocemos y aplicamos la NOM-197-SSA1, NOM-001-SEDE, NOM-020-STPS y todas las regulaciones aplicables a instalaciones hospitalarias. No subcontratamos la revisión normativa.",
  },
  {
    Icon: ClipboardCheck,
    title: "Proceso documentado en cada etapa",
    description:
      "Entregamos memorias de cálculo, planos as-built, protocolos de prueba y carpeta de cierre. Toda la evidencia que necesitas para inspecciones y acreditaciones.",
  },
  {
    Icon: Timer,
    title: "Respuesta en menos de 24 horas",
    description:
      "Atendemos solicitudes de cotización y emergencias operativas con respuesta rápida. Sabemos que en un entorno hospitalario, el tiempo inactivo tiene costo directo.",
  },
  {
    Icon: Headphones,
    title: "Interlocutor técnico desde día uno",
    description:
      "Tu proyecto no pasa por coordinadores generalistas. Desde la primera llamada hasta la entrega, hablas directamente con el ingeniero responsable.",
  },

  {
    Icon: MapPin,
    title: "Cobertura en toda la República",
    description:
      "Ejecutamos proyectos en hospitales, clínicas y laboratorios a lo largo de toda la República Mexicana, con personal propio en los estados con mayor demanda.",
  },
];
---

<Section class="bg-white">
  <Container>
    <div class="grid gap-16 lg:grid-cols-2 lg:items-center">
      <!-- Left: header + accent block -->
      <div class="flex flex-col gap-10">
        <SectionHeader
          eyebrow="Por qué elegirnos"
          title="Especialización que se nota en el resultado"
          description="En infraestructura hospitalaria, la diferencia entre un proveedor genérico y un especialista se mide en auditorías superadas, licencias obtenidas y riesgos evitados."
        />

        <!-- Stat row -->
        <div
          class="grid grid-cols-3 divide-x divide-neutral-border rounded-2xl border border-neutral-border bg-neutral-bg overflow-hidden"
        >
          <div class="flex flex-col items-center gap-1 p-5">
            <span
              class="font-heading font-extrabold text-3xl text-brand-turquoise"
              >100%</span
            >
            <span class="text-xs text-neutral-text text-center leading-tight"
              >Proyectos bajo normativa vigente</span
            >
          </div>
          <div class="flex flex-col items-center gap-1 p-5">
            <span
              class="font-heading font-extrabold text-3xl text-brand-turquoise"
              >8</span
            >
            <span class="text-xs text-neutral-text text-center leading-tight"
              >Especialidades hospitalarias</span
            >
          </div>
          <div class="flex flex-col items-center gap-1 p-5">
            <span
              class="font-heading font-extrabold text-3xl text-brand-turquoise"
              >&lt;24 h</span
            >
            <span class="text-xs text-neutral-text text-center leading-tight"
              >Tiempo de respuesta inicial</span
            >
          </div>
        </div>

        <!-- CTA secondary -->
        <a
          href="/nosotros/"
          class="inline-flex w-fit items-center gap-2 rounded-lg border border-neutral-border px-6 py-3 text-sm font-semibold text-brand-dark transition-all hover:border-brand-teal-dark hover:shadow-sm"
        >
          Conocer al equipo
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Right: feature list -->
      <div class="grid gap-5 sm:grid-cols-2">
        {
          differentiators.map(({ Icon, title, description }) => (
            <div class="flex flex-col gap-3 rounded-xl border border-neutral-border bg-neutral-bg p-5 transition-all hover:border-brand-turquoise/40 hover:shadow-sm">
              <div class="w-9 h-9 rounded-lg bg-brand-turquoise/10 flex items-center justify-center text-brand-teal-dark">
                <Icon class="w-5 h-5" stroke-width={1.75} />
              </div>
              <h3 class="font-heading font-bold text-sm text-brand-dark">
                {title}
              </h3>
              <p class="text-xs text-neutral-text leading-relaxed">
                {description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</Section>
