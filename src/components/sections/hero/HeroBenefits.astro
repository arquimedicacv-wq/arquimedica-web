---
import {
    ShieldCheck,
    Building2,
    MapPinned,
    Wrench
} from "@lucide/astro";
---

<div class="grid grid-cols-2 gap-4">

    <div class="flex items-center gap-3">

        <ShieldCheck class="h-5 w-5 text-teal-600"/>

        <span>Cumplimiento normativo</span>

    </div>

    <div class="flex items-center gap-3">

        <Building2 class="h-5 w-5 text-teal-600"/>

        <span>Hospitales y clínicas</span>

    </div>

    <div class="flex items-center gap-3">

        <MapPinned class="h-5 w-5 text-teal-600"/>

        <span>Cobertura nacional</span>

    </div>

    <div class="flex items-center gap-3">

        <Wrench class="h-5 w-5 text-teal-600"/>

        <span>Ingeniería especializada</span>

    </div>

</div>