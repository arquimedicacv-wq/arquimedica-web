---
interface Props{
    icon:any;
    title:string;
}

const{
    icon:Icon,
    title
}=Astro.props;
---

<div
    class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">

    <div
        class="flex h-10 w-10 items-center justify-center rounded-full bg-cyan-50">

        <Icon class="h-5 w-5 text-teal-600"/>

    </div>

    <span class="font-medium text-slate-700">

        {title}

    </span>

</div>