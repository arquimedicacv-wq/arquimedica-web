---
import Container from "../../ui/container.astro";
import HeroContent from "./HeroContent.astro";
import HeroIllustration from "./HeroIllustration.astro";

interface Props {
  title?: string;
  highlighted?: string;
  description?: string;
  badgeText?: string;
  showIllustration?: boolean;
  showBenefits?: boolean;
  showActions?: boolean;
}

const {
  title = "Diseño e instalación de infraestructura hospitalaria",
  highlighted = "bajo normativas oficiales.",
  description = "Especialistas en gases medicinales, instalaciones eléctricas hospitalarias, aire acondicionado grado médico y sistemas críticos para hospitales, clínicas y laboratorios en toda la República Mexicana.",
  badgeText = "Ingeniería Hospitalaria Especializada",
  showIllustration = true,
  showBenefits = true,
  showActions = true,
} = Astro.props;
---

<section
  class="relative overflow-hidden bg-linear-to-br from-slate-50 via-white to-cyan-50"
>
  <Container>
    <div
      class="grid min-h-[calc(100svh-80px)] items-center gap-20 lg:grid-cols-2"
    >
      <HeroContent
        {title}
        {highlighted}
        {description}
        {badgeText}
        {showBenefits}
        {showActions}
      />
      {showIllustration && <HeroIllustration />}
    </div>
  </Container>
</section>
