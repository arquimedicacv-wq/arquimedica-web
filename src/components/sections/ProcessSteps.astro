---
import Section from "../ui/Section.astro";
import Container from "../ui/container.astro";
import SectionHeader from "../ui/SectionHeader.astro";

const steps = [
  {
    number: "01",
    title: "Contacto y diagnóstico inicial",
    description:
      "Nos describes el proyecto: tipo de instalación, etapa de obra, normativa requerida y plazos. En menos de 24 horas un ingeniero especialista te da una valoración preliminar sin costo.",
    detail: "WhatsApp · Llamada · Formulario",
  },
  {
    number: "02",
    title: "Visita técnica y levantamiento",
    description:
      "Realizamos un levantamiento en sitio para entender el alcance real: trazado de redes, cargas eléctricas, restricciones estructurales y requerimientos normativos específicos de la unidad.",
    detail: "Presencial o revisión de planos",
  },
  {
    number: "03",
    title: "Ingeniería y propuesta detallada",
    description:
      "Elaboramos la memoria de cálculo, planos de diseño y especificaciones técnicas. La propuesta económica es itemizada: sabes exactamente qué estás comprando y por qué.",
    detail: "Propuesta en 3–5 días hábiles",
  },
  {
    number: "04",
    title: "Ejecución bajo protocolo normativo",
    description:
      "Instalamos con personal propio siguiendo los protocolos de cada NOM aplicable. Documentamos cada etapa: pruebas de hermeticidad, mediciones eléctricas, calibración de sistemas.",
    detail: "Sin subcontratistas en etapas críticas",
  },
  {
    number: "05",
    title: "Entrega con carpeta de certificación",
    description:
      "Al concluir entregamos la carpeta técnica completa: memorias, planos as-built, protocolos de prueba y manuales. Todo estructurado para que superes inspecciones de primer intento.",
    detail: "Listo para COFEPRIS y protección civil",
  },
];
---

<Section id="proceso" class="bg-neutral-bg overflow-hidden">
  <Container>
    <div class="mb-14 max-w-2xl">
      <SectionHeader
        eyebrow="Cómo trabajamos"
        title="Un proceso de ingeniería sin sorpresas"
        description="Cada proyecto sigue el mismo flujo estructurado. Sabes en qué etapa está tu obra y qué documentación recibirás al finalizar."
      />
    </div>

    <!-- Desktop: timeline horizontal -->
    <div class="hidden lg:block">
      <!-- Connecting line -->
      <div class="relative">
        <div
          class="absolute top-8 left-[calc(100%/10)] right-[calc(100%/10)] h-px bg-gradient-to-r from-transparent via-brand-turquoise/30 to-transparent"
        >
        </div>
        <div class="grid grid-cols-5 gap-6">
          {
            steps.map((step, index) => (
              <div class="flex flex-col items-center text-center gap-4 pt-0">
                <div class="relative z-10 flex h-16 w-16 items-center justify-center rounded-full border-2 border-brand-turquoise bg-white shadow-sm shadow-brand-turquoise/20">
                  <span class="font-heading font-extrabold text-brand-turquoise text-lg">
                    {step.number}
                  </span>
                </div>
                <div class="flex flex-col gap-2">
                  <h3 class="font-heading font-bold text-brand-dark text-sm">
                    {step.title}
                  </h3>
                  <p class="text-xs text-neutral-text leading-relaxed">
                    {step.description}
                  </p>
                  <span class="text-xs font-semibold text-brand-turquoise">
                    {step.detail}
                  </span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Mobile: vertical timeline -->
    <div class="flex flex-col gap-0 lg:hidden">
      {
        steps.map((step, index) => (
          <div class="flex gap-5">
            <div class="flex flex-col items-center">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-brand-turquoise bg-white shadow-sm">
                <span class="font-heading font-bold text-brand-turquoise text-sm">
                  {step.number}
                </span>
              </div>
              {index < steps.length - 1 && (
                <div class="mt-1 w-px flex-1 bg-brand-turquoise/20 mb-1 min-h-[2rem]" />
              )}
            </div>
            <div class="pb-8 flex flex-col gap-1.5 pt-2">
              <h3 class="font-heading font-bold text-brand-dark text-base">
                {step.title}
              </h3>
              <p class="text-sm text-neutral-text leading-relaxed">
                {step.description}
              </p>
              <span class="text-xs font-semibold text-brand-turquoise">
                {step.detail}
              </span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Bottom CTA banner -->
    <div
      class="mt-14 flex flex-col sm:flex-row items-center justify-between gap-6 rounded-2xl bg-white border border-neutral-border px-8 py-7"
    >
      <p
        class="text-brand-dark font-heading font-semibold text-lg text-center sm:text-left"
      >
        ¿Tienes un proyecto en mente? Empieza por el paso 1.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <a
          href="https://wa.me/5215519074304?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20sus%20servicios%20de%20instalaciones%20hospitalarias."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-brand-whatsapp px-6 py-3 font-heading font-semibold text-white transition-all hover:scale-[1.02] hover:shadow-md"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path>
          </svg>
          Escribir por WhatsApp
        </a>
        <a
          href="/contacto/"
          class="inline-flex items-center gap-2 rounded-lg border border-neutral-border bg-white px-6 py-3 font-heading font-semibold text-brand-dark transition-all hover:border-brand-teal-dark hover:shadow-sm"
        >
          Ver formulario de contacto
        </a>
      </div>
    </div>
  </Container>
</Section>
