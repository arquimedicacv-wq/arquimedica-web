---
import SectionHeading from "./SectionHeading.astro";

interface Props {
  requirements: string[];
  normativa: string[];
  homoclave?: string;
}
const { requirements, normativa, homoclave } = Astro.props;
---

<section id="requisitos" class="scroll-mt-24">
  <SectionHeading eyebrow="Requisitos" title="Requisitos generales" />
  <ul class="mt-6 space-y-2">
    {
      requirements.map((r) => (
        <li class="flex gap-3 border-b border-slate-100 pb-2 text-slate-700">
          <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-brand-turquoise" />
          <span>{r}</span>
        </li>
      ))
    }
  </ul>
  {
    normativa.length > 0 && (
      <div class="mt-8 rounded-xl bg-slate-50 p-5">
        <h3 class="font-semibold text-brand-dark">Normativa relacionada</h3>
        <ul class="mt-2 list-disc pl-6 text-sm text-slate-600">
          {normativa.map((n) => (
            <li>{n}</li>
          ))}
        </ul>
        {homoclave && (
          <p class="mt-3 text-sm text-slate-500">
            Homoclave del trámite: <strong>{homoclave}</strong>
          </p>
        )}
      </div>
    )
  }
</section>
