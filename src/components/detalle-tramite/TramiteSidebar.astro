---
interface Props {
  wa: string;
  entryId: string;
}
const { wa, entryId } = Astro.props;
---

<aside class="hidden lg:block">
  <div class="sticky top-24 space-y-4">
    <div class="overflow-hidden rounded-2xl border border-slate-200 shadow-lg">
      <div class="bg-brand-dark px-6 py-5 text-white">
        <h2 class="text-lg font-bold">Inicia tu trámite hoy</h2>
        <p class="mt-1 text-sm text-white/70">
          Diagnóstico inicial sin costo y respuesta en menos de 24 horas.
        </p>
      </div>
      <div class="space-y-3 bg-white p-6">
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="block rounded-xl bg-brand-turquoise px-4 py-3.5 text-center font-bold text-brand-dark transition hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-turquoise/40"
        >
          Escribir por WhatsApp
        </a>
        <a
          href={`/contacto/?tramite=${entryId}`}
          class="block rounded-xl border border-slate-300 px-4 py-3.5 text-center font-semibold text-brand-dark transition hover:border-brand-turquoise"
        >
          Solicitar cotización
        </a>
        <ul class="space-y-1.5 pt-2 text-xs text-slate-500">
          <li>✓ Sin costo ni compromiso</li>
          <li>✓ Un ingeniero revisa tu caso</li>
          <li>✓ Cobertura en toda la República</li>
        </ul>
      </div>
    </div>
  </div>
</aside>
