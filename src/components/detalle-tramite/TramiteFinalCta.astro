---
interface Props {
  shortTitle: string;
  wa: string;
  entryId: string;
}
const { shortTitle, wa, entryId } = Astro.props;
---

<section class="bg-brand-dark text-white">
  <div class="max-w-4xl mx-auto px-4 py-14 text-center">
    <h2 class="text-2xl md:text-3xl font-bold">
      ¿Listo para iniciar tu {shortTitle.toLowerCase()}?
    </h2>
    <p class="mt-3 text-white/75">
      Cuéntanos tu proyecto y recibe un diagnóstico en menos de 24 horas.
    </p>
    <div class="mt-7 flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href={wa}
        target="_blank"
        rel="noopener"
        class="rounded-xl bg-brand-turquoise px-7 py-3.5 font-bold text-brand-dark transition hover:-translate-y-0.5"
      >
        Escribir por WhatsApp
      </a>
      <a
        href={`/contacto/?tramite=${entryId}`}
        class="rounded-xl border border-white/25 px-7 py-3.5 font-semibold transition hover:bg-white/10"
      >
        Llenar formulario
      </a>
    </div>
  </div>
</section>
