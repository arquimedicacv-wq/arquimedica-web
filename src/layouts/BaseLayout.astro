---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import SocialFloat from "../components/layout/SocialFloat.astro";
import WhatsAppFloat from "../components/layout/WhatsAppFloat.astro";
import SEOHead from "../components/ui/SEOHead.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { title, description, ogImage, noindex, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://api.web3forms.com" />
    <link rel="preconnect" href="https://wa.me" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="alternate" type="application/rss+xml" title="Arqui-Médica | Recursos Técnicos" href="/recursos/rss.xml" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <SEOHead
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <main class="flex-1">
      <Header />
      <slot />
      <SocialFloat />
      <WhatsAppFloat />
      <Footer />
    </main>
  </body>
</html>
